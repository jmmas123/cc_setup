{
  "env": {
    "CLAUDE_CODE_DISABLED_ADAPTIVE_THINKING": "1"
  },
  "permissions": {
    "allow": [
      "Bash(yt mine:*)",
      "Bash(yt view:*)",
      "Bash(yt open:*)",
      "WebSearch",
      "WebFetch",
      "Bash(git:*)",
      "Bash(python3:*)",
      "Bash(tmux:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(curl:*)",
      "Bash(chmod:*)",
      "Bash(readlink:*)",
      "Bash(pgrep:*)",
      "Bash(sudo:*)",
      "Bash(brew:*)",
      "Bash(gh:*)",
      "Bash(crontab:*)",
      "Bash(mdfind:*)",
      "Bash(sw_vers:*)",
      "Bash(sysctl:*)",
      "Bash(pmset:*)",
      "Bash(npm:*)",
      "Bash(go:*)",
      "Bash(log show:*)",
      "Bash(launchctl:*)",
      "Bash(defaults read:*)",
      "Bash(open:*)",
      "Bash(/bin/bash:*)",
      "Bash(which:*)",
      "Bash(lsof:*)",
      "Bash(system_profiler:*)",
      "Bash(dscl:*)",
      "Bash(bash:*)",
      "Bash(ln:*)",
      "Bash(infocmp:*)",
      "Bash(env:*)",
      "Bash(osascript:*)",
      "Bash(terminal-notifier:*)",
      "Bash(/Applications/Ghostty.app/*:*)",
      "Bash(ghostty:*)",
      "Bash(man:*)",
      "Bash(/opt/homebrew/bin/tmux:*)",
      "Read(//tmp/**)",
      "Skill(keybindings-help)",
      "Bash(bun --version)",
      "Bash(_R=\"/Users/*/.claude/plugins/marketplaces/thedotmack/plugin\")",
      "Bash(node \"$_/scripts/bun-runner.js\" \"$_/scripts/worker-service.cjs\" hook claude-code summarize)",
      "Bash(node \"$_scripts/bun-runner.js\" \"$_scripts/worker-service.cjs\" hook claude-code summarize)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(stat:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(diff:*)",
      "Bash(file:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(jq:*)",
      "Bash(rg:*)",
      "Bash(shasum:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(date:*)",
      "Bash(uname:*)",
      "Bash(printf:*)",
      "Bash(command:*)",
      "Bash(type:*)",
      "Bash(whoami:*)",
      "Bash(hostname:*)",
      "Bash(xxd:*)",
      "Bash(column:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mktemp:*)",
      "Bash(cd:*)",
      "Bash(tee:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(/usr/libexec/PlistBuddy:*)",
      "Bash(plutil:*)",
      "Bash(fc-list:*)",
      "Bash(defaults:*)",
      "Bash(xcrun simctl:*)",
      "Bash(tmutil listlocalsnapshots:*)",
      "Bash(diskutil list:*)",
      "Bash(diskutil info:*)",
      "Bash(diskutil apfs:*)",
      "Bash(uv:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(ollama:*)",
      "Read(//opt/homebrew/**)",
      "Read(//usr/local/**)",
      "Bash(claude plugin *)",
      "Bash(semgrep mcp *)",
      "mcp__plugin_claude-mem_mcp-search__get_observations",
      "Bash(node /Users/*/.claude/plugins/cache/thedotmack/claude-mem/*/scripts/bun-runner.js *)",
      "Bash(node /Users/*/.claude/plugins/cache/thedotmack/claude-mem/*/scripts/smart-install.js)",
      "Bash(CLAUDE_PLUGIN_ROOT=/Users/*/.claude/plugins/cache/*/superpowers/* bash /Users/*/.claude/plugins/cache/*/superpowers/*/hooks/session-start)",
      "Bash(CLAUDE_PLUGIN_ROOT=/Users/*/.claude/plugins/cache/claude-plugins-official/explanatory-output-style/* bash /Users/*/.claude/plugins/cache/claude-plugins-official/explanatory-output-style/*/hooks-handlers/session-start.sh)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "agent",
            "prompt": "Before context compaction, capture session state for continuity. IMPORTANT: Record only FACTS, DECISIONS, and OUTCOMES — never preserve your own reasoning, explanations, or analysis (these are context pollution vectors that degrade future responses).\n\nSteps:\n1. Run `git status` and `git log --oneline -5`\n2. Create or update docs/STATE.md (or STATE.md if no docs/) with ONLY:\n   - **Facts**: Branch, run status, file paths changed, metrics observed\n   - **User decisions**: What the user chose and why (in their words, not yours)\n   - **Outcomes**: What worked, what failed, error messages verbatim\n   - **Blockers**: Specific technical blockers with error details\n   - **Pending**: Concrete next actions (not your suggestions — only what was agreed)\n3. Do NOT include: your analysis, recommendations, reasoning chains, or explanations\n4. Keep under 40 lines. Overwrite prior content entirely.",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-guard.sh",
            "timeout": 1000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-commands.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/checkpoint-notify.sh",
            "timeout": 2000
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/checkpoint-notify.sh",
            "timeout": 2000
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/checkpoint-notify.sh",
            "timeout": 2000
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "supabase@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "semgrep@claude-plugins-official": false,
    "claude-mem@thedotmack": true,
    "superpowers@superpowers-marketplace": false,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "verbose": true,
  "preferredNotifChannel": "iterm2_with_bell",
  "terminalProgressBarEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "mcpServers": {
    "dwh": {
      "command": "python3",
      "args": [
        "~/.claude/mcp/sql_server_mcp.py"
      ]
    }
  }
}
