{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "agent",
            "prompt": "Before context compaction, capture session state for continuity. IMPORTANT: Record only FACTS, DECISIONS, and OUTCOMES — never preserve your own reasoning, explanations, or analysis (these are context pollution vectors that degrade future responses).\n\nSteps:\n1. Run `git status` and `git log --oneline -5`\n2. Create or update docs/STATE.md (or STATE.md if no docs/) with ONLY:\n   - **Facts**: Branch, run status, file paths changed, metrics observed\n   - **User decisions**: What the user chose and why (in their words, not yours)\n   - **Outcomes**: What worked, what failed, error messages verbatim\n   - **Blockers**: Specific technical blockers with error details\n   - **Pending**: Concrete next actions (not your suggestions — only what was agreed)\n3. Do NOT include: your analysis, recommendations, reasoning chains, or explanations\n4. Keep under 40 lines. Overwrite prior content entirely.",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-guard.sh",
            "timeout": 1000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-commands.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/checkpoint-notify.sh",
            "timeout": 2000
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/checkpoint-notify.sh",
            "timeout": 2000
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/checkpoint-notify.sh",
            "timeout": 2000
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\" sound name \"Ping\"'"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "dwh": {
      "command": "python3",
      "args": ["~/.claude/mcp/sql_server_mcp.py"]
    }
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "semgrep@claude-plugins-official": true
  }
}
