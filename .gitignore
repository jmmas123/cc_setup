# Claude Code Setup Repository
# Only track configuration files — exclude all auto-generated and sensitive data

# ── Sensitive ──────────────────────────────────
.credentials.json
.env
settings.local.json
security_warnings_state_*.json
stats-cache.json

# ── Runtime artifacts ─────────────────────────
command-history.log
.log-rotated
.last-cleanup
scheduled_tasks.lock
mcp-needs-auth-cache.json
security/
.last-update-result.json
chrome/
daemon/
daemon.log
jobs/

# ── Auto-generated / Session data ─────────────
sessions/
image-cache/
history.jsonl
projects/
debug/
file-history/
paste-cache/
plans/
session-env/
shell-snapshots/
statsig/
tasks/
telemetry/
todos/
cache/
downloads/
backups/
ide/
# agent-memory: bare name (no trailing slash) so the Syncthing symlink is ignored too
agent-memory

# ── Plugin installs (managed by plugin system) ─
plugins/

# ── OS files ───────────────────────────────────
.DS_Store
